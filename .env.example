# Copy to .env (git-ignored) and fill in locally. NEVER commit real values.
CTS_DB_URL=jdbc:postgresql://localhost:55432/crypto_trading
CTS_DB_USERNAME=crypto_trading
CTS_DB_PASSWORD=change-me

# BACKTEST | TESTNET   (LIVE is locked in this build)
CTS_TRADING_MODE=BACKTEST

# Required. Generate each with: openssl rand -base64 32
CTS_JWT_SECRET=
CTS_MASTER_KEY=

# First TRADER user, created on startup if it does not exist (password >= 12 chars). Remove after first start.
CTS_ADMIN_USERNAME=
CTS_ADMIN_PASSWORD=

# TESTNET only (https://testnet.binance.vision). NEVER production keys here. Keys must not allow withdrawals.
CTS_BINANCE_TESTNET_API_KEY=
CTS_BINANCE_TESTNET_API_SECRET=

# Optional: Vite dev server origin for the WebSocket
# CTS_WS_ALLOWED_ORIGINS=http://localhost:5173
